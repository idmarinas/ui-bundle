{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props variant = 'accent' %}

{% set style = html_cva(
	base: 'rounded-lg text-sm p-2.5',
	variants: {
		variant: {
			primary: 'bg-primary text-primary-foreground  border border-transparent hover:border-border',
			secondary: 'bg-secondary text-secondary-foreground  border border-transparent hover:border-border',
			accent: 'bg-accent text-accent-foreground border border-transparent hover:border-border',
		}
	},
	default_variant: {
		variant: 'accent'
	}
) %}

<button
	id="theme-toggle"
	type="button"
	class="{{ style.apply({variant}, attributes.render('class'))|tailwind_merge }}"
	{{ attributes }}
	data-controller="theme-toggle"
	data-action="click->theme-toggle#toggle"
>
	<twig:UX:Icon
		name="tabler:sun-moon"
		id="theme-toggle-sun-moon-icon"
		class="{{ ('w-5 h-5 ' ~ attributes.nested('sun-moon').render('class'))|tailwind_merge }}"
		{{ attributes.nested('sun-moon') }}
	/>
	<twig:UX:Icon
		name="tabler:sun" id="theme-toggle-sun-icon"
		class="{{ ('w-5 h-5 hidden ' ~ attributes.nested('sun').render('class'))|tailwind_merge }}"
		{{ attributes.nested('sun') }}
	/>
	<twig:UX:Icon
		name="tabler:moon"
		id="theme-toggle-moon-icon"
		class="{{ ('w-5 h-5 hidden ' ~ attributes.nested('moon').render('class'))|tailwind_merge }}"
		{{ attributes.nested('moon') }}
	/>
</button>
