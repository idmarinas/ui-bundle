{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props variant, title, message %}

<twig:UI:Element:Alert:Base :variant="variant">
	<twig:UI:Alert:Icon :variant="variant" />
	<twig:UI:Alert:Container>
		{% if title is not empty %}
			<twig:UI:Alert:Title>{{ title }}</twig:UI:Alert:Title>
		{% endif %}
		<twig:UI:Alert:Message>
			{{ message }}
		</twig:UI:Alert:Message>
	</twig:UI:Alert:Container>
</twig:UI:Element:Alert:Base>
