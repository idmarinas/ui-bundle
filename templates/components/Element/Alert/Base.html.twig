{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props type %}

{% set style = html_cva(
	base: 'flex flex-row items-center p-5 rounded border-b-2 mb-2 text-left',
	variants: {
		type: {
			danger: 'bg-danger text-danger-foreground border-danger-border',
			error: 'bg-error text-error-foreground border-error-border',
			success: 'bg-success text-success-foreground border-success-border',
			warning: 'bg-warning text-warning-foreground border-warning-border',
			info: 'bg-info text-info-foreground border-info-border',
			notice: 'bg-notice text-notice-foreground border-notice-border'
		}
	},
	default_variant: {
		type: 'notice'
	}
) %}

<div
	role="alert"
	class="{{ style.apply({ type }, attributes.render('class'))|tailwind_merge }}"
	{{ attributes }}
>
	{% block content %}{% endblock %}
</div>
