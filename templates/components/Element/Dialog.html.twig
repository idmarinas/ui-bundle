{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props size %}

{% set style = html_cva(
	base: 'bg-primary-50 rounded-lg shadow-xl p-6 mb-6 sm:mb-auto',
	variants: {
		size: {
			small: '',
			medium: '',
			large: '',
			full: 'w-full'
		}
	},
	default_variant: {
		size: 'medium'
	}
) %}

<div data-controller="dialog" data-action="click->dialog#backdropClose" class="">
	<dialog
		data-dialog-target="dialog"
		class="{{ style.apply({ size }, attributes.render('class'))|tailwind_merge }}"
		{{ attributes }}
	>
		{% block content %}{% endblock %}
	</dialog>

	<span data-action="click->dialog#open">
		{% block activator %}{% endblock %}
	</span>
</div>
