{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props size = 'md' %}

{% set style = html_cva(
	base: 'bg-secondary text-secondary-foreground backdrop:bg-black/75 rounded-lg shadow-xl mb-6 sm:mb-auto',
	variants: {
		size: {
			xs: 'w-full sm:w-1/4',
			sm: 'w-full sm:w-1/3',
			md: 'w-full sm:w-2/5',
			lg: 'w-full sm:w-3/5',
			xl: 'w-full sm:w-3/4',
			screen: 'w-screen h-screen'
		}
	},
	default_variant: {
		size: 'md'
	},
	compound_variants: [
		{
			size: ['screen'],
			class: 'open:flex open:flex-col'
		}
	]
) %}

<div data-controller="dialog" data-action="click->dialog#backdropClose" class="">
	<dialog
		data-dialog-target="dialog"
		class="{{ style.apply({ size }, attributes.render('class'))|tailwind_merge }}"
		{{ attributes }}
	>
		{% block content %}{% endblock %}
	</dialog>

	<span data-action="click->dialog#open">
		{% block activator %}{% endblock %}
	</span>
</div>
