{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% set showCloseButton = not attributes.has('withCloseButton') or attributes.has('withCloseButton') and attributes.all().withCloseButton is same as(true) %}

{% set attributes = attributes.remove('withCloseButton') %}
<div
	class="{{ ('text-2xl font-medium flex flex-row gap-2 pr-6 ' ~ attributes.render('class'))|tailwind_merge }}"
	{{ attributes }}
>
	{% block content %}{% endblock %}

	{% if showCloseButton %}
		<button
			type="button"
			aria-label="{{ 'dialog.close'|trans(domain = 'IdmUiBundle') }}"
			data-action="click->dialog#close"
			class="absolute right-0"
		>
			<twig:UX:Icon name="close" class="h-6 w-6" />
		</button>
	{% endif %}
</div>
