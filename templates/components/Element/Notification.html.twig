{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

<twig:IdmUi:Element:Notification:Base :type="type">
	<twig:IdmUi:Element:Notification:Icon :type="type" />
	<twig:IdmUi:Element:Notification:Container>
		{% if title is not empty %}
			<twig:IdmUi:Element:Notification:Title>{{ title }}</twig:IdmUi:Element:Notification:Title>
		{% endif %}
		<twig:IdmUi:Element:Notification:Message>{{ message }}</twig:IdmUi:Element:Notification:Message>
	</twig:IdmUi:Element:Notification:Container>
	{% if closable is same as(true) %}
		<twig:IdmUi:Element:Notification:Closable />
	{% endif %}
</twig:IdmUi:Element:Notification:Base>
