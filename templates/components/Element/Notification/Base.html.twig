{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props type, duration = 5000 %}

{% set style = html_cva(
	base: 'border-l-4 transition transform duration-1000 max-w-sm w-full shadow-lg px-4 py-3 mb-4 rounded relative pointer-events-auto',
	variants: {
		type: {
			danger: 'bg-red-200 border-red-500 text-red-700',
			error: 'bg-red-200 border-red-500 text-red-700',
			success: 'bg-green-200 border-green-500 text-green-700',
			warning: 'bg-yellow-200 border-yellow-500 text-yellow-700',
			info: 'bg-blue-200 border-blue-500 text-blue-700',
			notice: 'bg-gray-200 border-gray-500 text-gray-700'
		}
	},
	default_variant: {
		type: 'notice'
	}
) %}

<div
	role="alert"
	class="{{ style.apply({ type }, attributes.render('class'))|tailwind_merge }}"
	{{ attributes.defaults({
		'data-controller': 'notification',
		'data-notification-delay-value': duration,
		'data-transition-enter-from': 'opacity-0 translate-x-6',
		'data-transition-enter-to': 'opacity-100 translate-x-0',
		'data-transition-leave-from': 'opacity-100 translate-x-0',
		'data-transition-leave-to': 'opacity-0 translate-x-6'
	}) }}
>
	<div class="p-2">
		<div class="flex items-start">
			{% block content %}{% endblock %}
		</div>
	</div>
</div>
