{# @var attributes \Symfony\UX\TwigComponent\ComponentAttributes #}

{% props type = 'notice' %}

{% if not enum('Idm\\Bundle\\Ui\\Twig\\Components\\Option\\MessageVariantEnum').isValidValue(type) %}
	{% set type = 'notice' %}
{% endif %}

{% set style = html_cva(
	base: 'flex items-center border-2 justify-center h-10 w-10 flex-shrink-0 rounded-full',
	variants: {
		type: {
			danger: 'bg-danger-icon border-danger-border',
			error: 'bg-error-icon border-error-border',
			success: 'bg-success border-success-border',
			warning: 'bg-warning border-warning-border',
			info: 'bg-info border-info-border',
			notice: 'bg-notice border-notice-border'
		}
	}
) %}

<div
	class="{{ style.apply({ type }, attributes.render('class'))|tailwind_merge }}"
	{{ attributes }}
>
	<twig:UX:Icon :name="'toast:' ~ type" class="h-5 w-5" />
</div>
